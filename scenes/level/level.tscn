[sub_resource type="Resource" id="Resource_82cxb"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "For many decades, this world has been plunged into freezing darkness… "
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_5feqo"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "The Sun forever remained eclipsed by a great being harnessing its power."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_d7w1m"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "Only those who remain with the warmth of light remain alive."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_5epdk"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "Many believe the Eclipse will share the Sun. "
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_sjrql"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "But, you know what REALLY happened... "
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_33qwd"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "That damned Eclipse killed every single Imp left standing with the power of the Sun’s flames."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_nin2s"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "You, sole Imp, managed to be hidden from the horrors, only left to grow up in this world without knowing day and its warmth."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_dcp4k"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "Your life mission is to get that Sun`s light back, or die trying. "
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_gmr2u"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "You can move around with WASD, fire with F, and interact with E."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_uf531"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "Don't run out of fuel, you`ll surely perish."
is_muted = true
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_0fkkc"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "The local hounds and fowl have succumbed to the darkness. They yearn to steal your fuel to live."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_yoh1m"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "As such, you can harvest theirs all the same."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_tf2q7"]
size = Vector2(31, 39)

[sub_resource type="Resource" id="Resource_cqqhe"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "A friend of mine got lost up ahead. Please find him."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_wyi7n"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "If you're lucky... he might just have something for you."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_3rml5"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "You should know, hidden around here in clusters of ice..."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_a5iu8"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "...are 2 remaining tools which are stronger than your pocket lighter."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

[sub_resource type="Resource" id="Resource_b3up8"]
script = ExtResource("7_m0bv2")
person = ExtResource("8_b7m21")
dialog = "Finding them would be of great interest to you."
metadata/_custom_type_script = "uid://c66jua0epg6uf"

